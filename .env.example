# SITE_API_KEY: Required for PROJETO API calls.
# automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
SITE_API_KEY="MY_SITE_API_KEY"

# SITE_URL: The URL where this applet is hosted.
# automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
SITE_URL="MY_SITE_URL"
